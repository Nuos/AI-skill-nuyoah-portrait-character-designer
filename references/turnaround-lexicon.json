{
  "schema_version": 1,
  "version": "0.3.1",
  "source": "User-supplied photorealistic mythic laborer prompt, 2026-09-25; edited into scoped reusable vocabulary.",
  "default_ids": [
    "photo.realism",
    "sheet.separation",
    "portrait.crop",
    "fullbody.frame",
    "sheet.alignment",
    "body.natural",
    "body.explicit_ratio",
    "skin.microtexture",
    "hair.continuity",
    "costume.continuity",
    "expression.same_moment",
    "standing.neutral",
    "side.orthogonal",
    "back.no_turn",
    "camera.fullbody",
    "light.soft_studio",
    "identity.lock",
    "marks.no_mirror",
    "image.no_annotations"
  ],
  "terms": [
    {
      "id": "photo.realism",
      "group": "摄影质感",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "真人写实摄影，纪实摄影质感；真实演员在专业摄影棚完成同一次定妆拍摄的观感，保留真实人体结构、自然皮肤和衣料材质，不进行商业美颜。",
      "negative": [
        "动漫",
        "插画",
        "游戏建模感",
        "三维渲染感",
        "过度磨皮",
        "蜡像皮肤",
        "塑料皮肤"
      ]
    },
    {
      "id": "sheet.separation",
      "group": "画面布局",
      "scope": "universal",
      "views": [
        "sheet"
      ],
      "when": "always",
      "text": "photorealistic character reference sheet，character turnaround。四列是同一人物的独立取景记录，不是四个人共同站在摄影棚里的合影；中性留白分隔轮廓，无分隔线、边框或装饰。",
      "negative": [
        "四人合影",
        "多余视图",
        "多余头像",
        "人物重叠",
        "分隔线",
        "边框"
      ]
    },
    {
      "id": "portrait.crop",
      "group": "局部取景",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait"
      ],
      "when": "always",
      "text": "正面人像特写为眼平视角，完整展示头顶至锁骨；头发、可见耳部及下巴不被画框裁切，双眼清楚，头顶留安全余量。面部约占特写局部构图的60%，这不是整张四视图的占比，也不是精确像素验收值。",
      "negative": [
        "头顶裁切",
        "下巴裁切"
      ]
    },
    {
      "id": "fullbody.frame",
      "group": "全身取景",
      "scope": "universal",
      "views": [
        "sheet",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "全身为 full body, head to toe，完整头顶至身体最下缘与足部均在画框内，上下保留安全余量；正确侧面允许远侧手脚被身体自然遮挡，不为露出每根手指而扭转身体。",
      "negative": [
        "脚部裁切",
        "脚尖出画",
        "头顶裁切",
        "重复肢体"
      ]
    },
    {
      "id": "sheet.alignment",
      "group": "尺度基线",
      "scope": "universal",
      "views": [
        "sheet"
      ],
      "when": "always",
      "text": "三张全身使用相同缩放比例和相机几何，头顶、肩线、腰线、膝部或对应身体标志保持对应；特写单独放大，不参与三张全身的头部大小比较。",
      "negative": [
        "比例不一致",
        "头顶高度不一致",
        "地面基线不一致"
      ]
    },
    {
      "id": "body.natural",
      "group": "身体比例",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "natural_ratio",
      "text": "保持该角色自身年龄、体型与参考比例；不套用统一成人模特比例，不通过异常缩头或单独拉长小腿制造高挑感。",
      "negative": [
        "与角色年龄不符的头身比例",
        "异常缩头",
        "不符合角色的肢体比例",
        "过度拉长双腿"
      ]
    },
    {
      "id": "body.explicit_ratio",
      "group": "身体比例",
      "scope": "conditional",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "explicit_ratio",
      "text": "头身比仅按用户明确给定值处理：头长以头部解剖顶部至下巴为参照，不计蓬松头发、头饰或鞋底。英雄式比例是造型目标，不是已测得的真实人体比例；若与参考身份冲突，先保留身份并标记待确认。",
      "negative": [
        "异常小头",
        "过度拉长双腿"
      ]
    },
    {
      "id": "skin.microtexture",
      "group": "皮肤",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "保留与年龄和身份相符的毛孔、细纹、自然褶皱及局部肤色差异；细节密度随取景变化，不给所有人统一加雀斑、伤痕、尘土或老化纹理。",
      "negative": [
        "皮肤自发光",
        "水光美容肌",
        "过度锐化"
      ]
    },
    {
      "id": "hair.continuity",
      "group": "毛发",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "发际线、分发位置、发长、鬓角与后脑发量在所有视图中一致；发丝有粗细与清晰度层次，不把每根发丝都锐化成等粗硬线，不新增遮住双眼的发束。",
      "negative": [
        "发型漂移",
        "过度锐化"
      ]
    },
    {
      "id": "costume.continuity",
      "group": "服装",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "领口、衣长、束腰位置、缝线、扣合、图案及已指定磨损均属于同一件衣服；随视角呈现其相应部位，不重新设计侧面或背面，不把正面图案复制到背面。",
      "negative": [
        "服装漂移"
      ]
    },
    {
      "id": "expression.same_moment",
      "group": "神情",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "所有可见面部表现同一时刻、同一种情绪与嘴唇状态，不制作表情变化序列；背面不因展示表情而回头。",
      "negative": [
        "不同年龄",
        "表情序列",
        "背面回头"
      ]
    },
    {
      "id": "standing.neutral",
      "group": "姿态",
      "scope": "conditional",
      "views": [
        "sheet",
        "front",
        "side",
        "back"
      ],
      "when": "standing",
      "text": "自然中性站姿，双腿自然伸直但不锁死膝关节，双脚平行微分、间距略窄于肩宽，稳定承重，不跨步、不踮脚。双臂自然下垂并略离躯干，手指自然微曲，不握拳、不遮挡腰线。",
      "negative": [
        "屈膝站立",
        "踮脚",
        "跨步",
        "漂浮脚底"
      ]
    },
    {
      "id": "side.orthogonal",
      "group": "方向",
      "scope": "universal",
      "views": [
        "sheet",
        "side"
      ],
      "when": "always",
      "text": "侧视图严格90°，头部、胸腔与骨盆同向；只改变观察方向，不扭腰摆出三分之四视角，不通过镜像获得另一侧。",
      "negative": [
        "侧面变成四分之三视角",
        "身体扭转"
      ]
    },
    {
      "id": "back.no_turn",
      "group": "方向",
      "scope": "universal",
      "views": [
        "sheet",
        "back"
      ],
      "when": "unsupported",
      "text": "背面严格180°，头与身体完全背对镜头，不回头，不额外露出侧脸；服装、发型和可见身体结构与其它视图对应。",
      "negative": [
        "背面回头",
        "身体扭转"
      ]
    },
    {
      "id": "camera.fullbody",
      "group": "相机",
      "scope": "universal",
      "views": [
        "sheet",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "全身采用中长焦、低透视畸变的摄影观感，相机水平；站姿机位约在腰胸之间，坐姿或受托姿态按身体高度调整。保持全身清楚，不使用明显浅景深，不以仰拍或广角透视拉长双腿。",
      "negative": [
        "广角畸变",
        "鱼眼",
        "强烈景深虚化",
        "透视性拉腿"
      ]
    },
    {
      "id": "light.soft_studio",
      "group": "照明",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "大面积柔光均匀照明，轻微塑造骨相与身体体积；只保留柔和接触阴影，高光不过曝，暗部不死黑。四视图共享白平衡、曝光与灯位方案；身体转向造成的合理受光差异不能被误判为肤色漂移。",
      "negative": [
        "硬阴影",
        "死黑暗部",
        "过曝高光"
      ]
    },
    {
      "id": "identity.lock",
      "group": "身份",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "身份一致性优先于装饰：头骨轮廓、五官比例、耳形、发际线、肤色、身体体量、肩宽、腰围、四肢长度和手脚尺寸保持一致；只改变取景范围与观察方向。",
      "negative": [
        "不同人物",
        "面容漂移",
        "畸形手脚",
        "多余手指",
        "融合手指"
      ]
    },
    {
      "id": "marks.no_mirror",
      "group": "侧别标记",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "有明确标记时按角色自身解剖左右记录；伤痕、痣和单侧配饰只在其所在部位可见时出现，形状长度不变，不迁移到另一侧。看不见的标记不等于消失。",
      "negative": [
        "伤痕左右翻转",
        "单侧配饰镜像"
      ]
    },
    {
      "id": "image.no_annotations",
      "group": "画面限制",
      "scope": "universal",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "图中不出现文字、字母、数字、标签、身高标尺、尺寸线、标志、签名或水印；段落标题只用于组织提示词，不是画面内容。",
      "negative": [
        "文字",
        "字母",
        "数字",
        "标签",
        "标尺",
        "尺寸线",
        "标志",
        "签名",
        "水印"
      ]
    },
    {
      "id": "laborer.lean_strength",
      "group": "劳动体型",
      "scope": "character",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "adult",
      "text": "成年劳动者的精瘦力量感：肌肉与肌腱清楚但不夸张充血，前臂与手背可有自然静脉，不让血管遍布全身，不病态消瘦。",
      "negative": [
        "夸张健美肌肉",
        "过度凸起的血管",
        "病态消瘦"
      ]
    },
    {
      "id": "laborer.restrained_fatigue",
      "group": "疲态",
      "scope": "character",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "adult_standing",
      "text": "疲惫通过眼周、微弱肩背张力和收敛神情表达；站姿仍保持整体身高与腿长，不通过明显佝偻、头颈前探或屈膝夸张疲态。",
      "negative": [
        "过度佝偻",
        "屈膝站立"
      ]
    },
    {
      "id": "skin.weathered_dust",
      "group": "风霜皮肤",
      "scope": "character",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "adult",
      "text": "仅此风霜角色保留轻微尘土与细小擦痕，不覆盖关键五官，不把所有皮肤涂成统一污灰色；以自然哑光为主，仅额头、鼻梁、颧部或肩部有弱汗光。",
      "negative": [
        "统一污灰肤色",
        "全脸油亮"
      ]
    },
    {
      "id": "costume.worn_linen",
      "group": "破旧亚麻",
      "scope": "character",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "always",
      "text": "粗亚麻纤维、褶皱、褪色、磨损边缘、少量破口与汗尘沿同一件衣服连续分布；落魄来自材料状态，不自动变成另一套服装。",
      "negative": []
    },
    {
      "id": "feet.barefoot",
      "group": "赤足",
      "scope": "character",
      "views": [
        "sheet",
        "front",
        "side",
        "back"
      ],
      "when": "standing",
      "text": "该角色赤足，脚趾、足背、脚踝与承重关系自然，足底与地面接触可信；不自动生成鞋袜。",
      "negative": [
        "鞋袜",
        "漂浮脚底"
      ]
    },
    {
      "id": "myth.no_equipment",
      "group": "神话劳作者限制",
      "scope": "character",
      "views": [
        "sheet",
        "portrait",
        "front",
        "side",
        "back"
      ],
      "when": "adult",
      "text": "此特定神话劳作者不戴头冠、发饰，无披风、盔甲或华丽纹样；摄影棚里没有山体、巨石、武器、锁链和其它剧情道具。",
      "negative": [
        "披风",
        "盔甲",
        "华丽纹样",
        "现代服饰",
        "山体",
        "巨石",
        "武器",
        "锁链"
      ]
    }
  ]
}
